
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explore Bali - Travel Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <h2 class="logo">Explore<span>Bali.</span></h2>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#places">Destinations</a></li>
                <li><a href="#packages">Packages</a></li>
                <li><a href="#activities">Activities</a></li>
                <li><a href="#booking">Book Now</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <h1>Discover The Beauty Of Bali</h1>
            <p>
                Explore beautiful beaches, amazing temples,
                green landscapes and unforgettable adventures.
            </p>
            <a href="#places" class="btn">Explore Now</a>
        </div>
    </section>

    <!-- Destinations Section -->
    <section class="destinations" id="places">
        <h2>Popular Destinations</h2>
        <p class="subtitle">Discover the most beautiful places in Bali</p>

        <div class="destination-container">

            <div class="destination-card">
                <img src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=700" alt="Bali temple">
                <h3>Uluwatu Temple</h3>
                <p>Experience beautiful ocean views and ancient temples.</p>
            </div>

            <div class="destination-card">
                <img src="https://images.unsplash.com/photo-1518548419970-58e3b4079ab2?w=700" alt="Bali beach">
                <h3>Nusa Penida</h3>
                <p>Enjoy crystal-clear waters and stunning beaches.</p>
            </div>

            <div class="destination-card">
                <img src="https://images.unsplash.com/photo-1530789253388-582c481c54b0?w=700" alt="Tropical landscape">
                <h3>Ubud</h3>
                <p>Explore green rice terraces and beautiful nature.</p>
            </div>

        </div>
    </section>

    <!-- Packages Section -->
    <section class="packages" id="packages">
        <h2>Our Travel Packages</h2>
        <p class="subtitle">Choose your perfect holiday package</p>

        <div class="package-container">

            <div class="package-card">
                <h3>Basic Package</h3>
                <h2>₹9,999</h2>
                <p>2 Days / 1 Night</p>
                <ul>
                    <li>Hotel Accommodation</li>
                    <li>Breakfast Included</li>
                    <li>Local Sightseeing</li>
                    <li>Tour Guide</li>
                </ul>
                <a href="#booking" class="btn">Book Now</a>
            </div>

            <div class="package-card featured">
                <h3>Premium Package</h3>
                <h2>₹19,999</h2>
                <p>4 Days / 3 Nights</p>
                <ul>
                    <li>Luxury Hotel Stay</li>
                    <li>All Meals Included</li>
                    <li>Adventure Activities</li>
                    <li>Airport Pickup</li>
                </ul>
                <a href="#booking" class="btn">Book Now</a>
            </div>

            <div class="package-card">
                <h3>Luxury Package</h3>
                <h2>₹29,999</h2>
                <p>6 Days / 5 Nights</p>
                <ul>
                    <li>5-Star Resort</li>
                    <li>Private Transport</li>
                    <li>Water Sports</li>
                    <li>Special Dinner</li>
                </ul>
                <a href="#booking" class="btn">Book Now</a>
            </div>

        </div>
    </section>

    <!-- Activities Section -->
    <section class="activities" id="activities">
        <h2>Exciting Activities</h2>
        <p class="subtitle">Make your holiday unforgettable</p>

        <div class="activity-container">

            <div class="activity-card">
                <img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=700" alt="Scuba diving">
                <h3>Scuba Diving</h3>
            </div>

            <div class="activity-card">
                <img src="https://images.unsplash.com/photo-1500534623283-312aade485b7?w=700" alt="Mountain adventure">
                <h3>Nature Adventures</h3>
            </div>

            <div class="activity-card">
                <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=700" alt="Beach relaxation">
                <h3>Beach Relaxation</h3>
            </div>

        </div>
    </section>

    <!-- Booking Section -->
    <section class="booking" id="booking">
        <h2>Book Your Dream Trip</h2>
        <p class="subtitle">Plan your perfect Bali vacation with us</p>

        <form class="booking-form">
            <input type="text" placeholder="Your Full Name" required>

            <input type="email" placeholder="Your Email Address" required>

            <input type="tel" placeholder="Phone Number">

            <select required>
                <option value="">Select Destination</option>
                <option>Uluwatu Temple</option>
                <option>Nusa Penida</option>
                <option>Ubud</option>
            </select>

            <input type="date" required>

            <select required>
                <option value="">Select Package</option>
                <option>Basic Package</option>
                <option>Premium Package</option>
                <option>Luxury Package</option>
            </select>

            <button type="submit">Submit Booking</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <h2>Explore<span>Bali.</span></h2>
        <p>Your journey begins with us. Discover, Explore and Enjoy!</p>
        <p>© 2026 Explore Bali. All Rights Reserved.</p>
    </footer>

</body>
</html>
